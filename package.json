{
  "name": "skill-loom-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Local web application for assembling and running ordered chains of agent skills.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "skill-loom": "dist/src/server/cli.js"
  },
  "files": [
    "dist/src",
    "dist/web",
    "dist/skills",
    "dist/package.json",
    "docs/OPERATIONS.md"
  ],
  "scripts": {
    "predev": "npm run build:portable-skill",
    "dev": "node scripts/dev-supervisor.mjs",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:portable-skill && npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json && node scripts/copy-scenario-skills.mjs",
    "build:portable-skill": "node scripts/build-portable-skill.mjs",
    "prepack": "npm run build",
    "start": "node dist/src/server/index.js",
    "typecheck": "npm run typecheck:server && npm run typecheck:web",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:package": "node scripts/package-smoke.mjs",
    "docs:capture": "node scripts/capture-tour.mjs",
    "test:live:discovery": "tsx scripts/live-discovery.ts",
    "test:live:execution": "tsx scripts/live-execution.ts",
    "check": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@fastify/static": "10.1.9",
    "@fastify/websocket": "11.3.6",
    "fastify": "5.12.8",
    "node-pty": "1.1.0",
    "react-markdown": "10.1.0",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "ws": "8.22.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "fflate": "^0.8.3",
    "gifenc": "1.0.3",
    "pngjs": "7.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
