  "cards": [
    {
      "dot": "amber",
      "title": "The helper never runs the harness",
      "items": [
        "The host performs each instruction with its own tools",
        "An outcome is agent-reported, not a verified process exit",
        "A named skill may still decline to load"
      ]
    },
    {
      "dot": "rose",
      "title": "Two separate consents",
      "items": [
        "Inspect is read-only and returns a review digest",
        "Prepare installs packages only after explicit confirmation",
        "An installed package is never overwritten"
      ]
    },
    {
      "dot": "cyan",
      "title": "One unfinished run",
      "items": [
        "A project-local claim rejects a second preparation or step",
        "It does not coordinate with managed runs or older helpers",
        "Resume needs the earlier work confirmed stopped"
      ]
    },
    {
      "dot": "violet",
      "title": "Mixed-origin bundles",
      "items": [
        "A bundle may carry pinned remote candidates and reviewed local skills",
        "The builder verifies each local fingerprint before staging",
        "The run path is unchanged: inspect, prepare, step, record"
      ]
