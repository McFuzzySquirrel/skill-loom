    },
    {
      "id": "failed",
      "type": "failure",
      "label": "Failed",
      "sublabel": "explicit failure",
      "tag": "final",
      "sources": [{ "path": "src/server/runs/model.ts", "line": 54, "end_line": 55 }]
    },
    {
      "id": "aborted",
      "type": "neutral",
      "label": "Aborted",
      "sublabel": "operator stopped it",
      "tag": "final",
      "sources": [{ "path": "src/server/runs/model.ts", "line": 54, "end_line": 55 }]
