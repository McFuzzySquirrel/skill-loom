  "transitions": [
    { "id": "starting-running", "from": "starting", "to": "running", "label": "runner starts" },
    { "id": "running-completed", "from": "running", "to": "completed", "label": "last step done" },
    { "id": "running-awaiting", "from": "running", "to": "awaiting-user", "label": "step ends" },
    { "id": "awaiting-running", "from": "awaiting-user", "to": "running", "label": "done or next" },
    { "id": "running-paused", "from": "running", "to": "paused", "label": "pause or timeout", "variant": "dashed" },
    { "id": "paused-running", "from": "paused", "to": "running", "label": "resume" },
    { "id": "running-failed", "from": "running", "to": "failed", "label": "explicit failure" },
    { "id": "running-aborted", "from": "running", "to": "aborted", "label": "abort" },
    { "id": "awaiting-aborted", "from": "awaiting-user", "to": "aborted", "label": "abort" },
    { "id": "paused-aborted", "from": "paused", "to": "aborted", "label": "abort" },
    { "id": "starting-interrupted", "from": "starting", "to": "interrupted", "label": "restart", "variant": "dashed" },
    { "id": "running-interrupted", "from": "running", "to": "interrupted", "label": "restart", "variant": "dashed" },
    { "id": "awaiting-interrupted", "from": "awaiting-user", "to": "interrupted", "label": "restart", "variant": "dashed" },
    { "id": "paused-interrupted", "from": "paused", "to": "interrupted", "label": "restart", "variant": "dashed" },
    { "id": "interrupted-starting", "from": "interrupted", "to": "starting", "label": "retry, continue, or restart", "variant": "emphasis" }
  ],
  "cards": [
    {
      "dot": "amber",
      "title": "One slot",
      "items": [
        "Starting, running, awaiting user, and paused hold the single active slot",
        "A second start is refused instead of queued",
        "A final status releases the slot"
      ]
    },
    {
      "dot": "rose",
      "title": "Recovery is explicit",
      "items": [
        "Startup marks active records interrupted",
        "Retry resets only the interrupted step",
        "Continue starts at the next pending step",
        "Restart creates a new run from the frozen chain"
      ]
    }
  ]
}
