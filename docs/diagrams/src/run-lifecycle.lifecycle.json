    },
    {
      "id": "running",
      "type": "active",
      "label": "Running",
      "sublabel": "one step in flight",
      "tag": "owns slot",
      "step": "02",
      "sources": [{ "path": "src/server/runs/model.ts", "line": 31, "end_line": 55 }]
    },
    {
      "id": "awaiting-user",
      "type": "waiting",
      "label": "Awaiting user",
      "sublabel": "confirm the step",
