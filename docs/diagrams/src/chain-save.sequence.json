    {
      "dot": "amber",
      "title": "Revision is required",
      "items": [
        "The editor sends the revision it loaded",
        "The service compares SHA-256 of the stored chain",
        "A mismatch returns a stale-chain error, not a merge"
      ]
    },
    {
      "dot": "rose",
      "title": "Commit is crash-safe",
      "items": [
        "The temporary file lives beside the target",
        "The write flushes before an atomic rename",
        "A symlink or escaped id is refused"
      ]
    },
    {
      "dot": "cyan",
      "title": "One writer per chain",
      "items": [
        "Mutations for the same project and chain are serialized",
        "The server owns ids and timestamps",
        "A successful save resets the editor's dirty baseline"
      ]
